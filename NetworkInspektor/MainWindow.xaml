<Window x:Class="NetworkInspektor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Network Inspector" Width="750" Height="450">
    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="437*"/>
            <ColumnDefinition Width="297*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="80" />
            <RowDefinition Height="*" />
            <RowDefinition Height="92" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="Black" BorderThickness="1" Padding="18,8" Grid.ColumnSpan="2">
            <TextBlock Text="Network Inspector" FontSize="26" FontWeight="Bold" VerticalAlignment="Center" />
        </Border>

        <Grid Grid.Row="1" Margin="0,6,0,6" Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderBrush="Black" BorderThickness="1" Padding="12,8">
                <StackPanel>
                    <TextBlock Text="Seznam adaptérů" FontSize="22" FontWeight="Bold" Margin="0,0,0,8" />
                    <ListBox x:Name="lstAdaptery" Width="250" HorizontalAlignment="Left" SelectionChanged="LstAdaptery_SelectionChanged">
                        <ListBoxItem Content="Wi-Fi" IsSelected="True" />
                        <ListBoxItem Content="Ethernet" />
                        <ListBoxItem Content="Bluetooth Network" />
                        <ListBoxItem Content="VMware Network Adapter" />
                    </ListBox>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" BorderBrush="Black" BorderThickness="1" Padding="12,8" Margin="6,0,0,0">
                <StackPanel>
                    <TextBlock Text="Detail vybraného adaptéru" FontSize="22" FontWeight="Bold" Margin="0,0,0,8" />
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="105" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Text="Název" FontWeight="Bold" />
                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="txtNazev" Text="Wi-Fi" />
                        <TextBlock Grid.Row="1" Text="Stav" FontWeight="Bold" />
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="txtStav" Text="Připojeno (Up)" />
                        <TextBlock Grid.Row="2" Text="IPv4" FontWeight="Bold" />
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="txtIPv4" Text="192.168.8.105" />
                        <TextBlock Grid.Row="3" Text="Maska" FontWeight="Bold" />
                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="txtMaska" Text="255.255.255.0" />
                        <TextBlock Grid.Row="4" Text="Výchozí brána" FontWeight="Bold" />
                        <TextBlock Grid.Row="4" Grid.Column="1" x:Name="txtBrana" Text="192.168.8.1" />
                        <TextBlock Grid.Row="5" Text="DNS" FontWeight="Bold" />
                        <TextBlock Grid.Row="5" Grid.Column="1" x:Name="txtDNS" Text="192.168.8.14, 8.8.8.8" />
                        <TextBlock Grid.Row="6" Text="MAC" FontWeight="Bold" />
                        <TextBlock Grid.Row="6" Grid.Column="1" x:Name="txtMac" Text="00-15-5D-31-44-01" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <UniformGrid Grid.Row="1" Columns="5" VerticalAlignment="Top" Grid.ColumnSpan="2" Margin="0,246,0,0" Grid.RowSpan="2">
            <Button Content="Načíst konfiguraci" Height="40" Margin="2" Click="BtnNacist_Click" />
            <Button Content="Ping" Height="40" Margin="2" />
            <Button Content="Test DNS" Height="40" Margin="2" />
            <Button Content="Zjistit hostname" Height="40" Margin="2" />
            <Button Content="Veřejná IP" Height="40" Margin="2" />
        </UniformGrid>
    </Grid>
</Window>
